---
import { resolveShareAvatarUrl } from "../content";

interface Props {
	url: string | null | undefined;
	anonymous?: boolean;
	authorName?: string | null;
	sizeClass: string;
	size?: number;
	eager?: boolean;
}

const {
	url,
	anonymous,
	authorName,
	sizeClass,
	size,
	eager = false,
} = Astro.props;
const avatarUrl = resolveShareAvatarUrl(url, anonymous, authorName);
const isExternal = avatarUrl.startsWith("http");
---

<img
	class={`${sizeClass} shrink-0 rounded-full bg-muted object-cover ring-1 ring-border/50`}
	src={avatarUrl}
	width={size}
	height={size}
	alt=""
	loading={eager ? undefined : "lazy"}
	decoding={eager ? undefined : "async"}
	referrerpolicy={isExternal ? "no-referrer" : undefined}
/>
