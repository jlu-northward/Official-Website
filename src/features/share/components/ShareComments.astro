---
import {
	extractMusicRefs,
	formatShareDate,
	musicRefKey,
	renderCommentText,
	safeUrl,
} from "../content";
import type { MusicCard, ShareFloor } from "../types";
import ShareAvatar from "./ShareAvatar.astro";
import ShareMusicCards from "./ShareMusicCards.astro";

interface Props {
	floors: ShareFloor[];
	totalFloors: number;
	commentCount: number;
	musicCardMap?: ReadonlyMap<string, MusicCard>;
}

const MAX_COMMENT_IMAGES = 3;
const MAX_COMMENT_MUSIC = 3;
const {
	floors,
	totalFloors,
	commentCount,
	musicCardMap = new Map<string, MusicCard>(),
} = Astro.props;
const shownComments = floors.reduce(
	(sum, floor) => sum + 1 + (floor.replies ? floor.replies.length : 0),
	0,
);
const hasHiddenComments =
	totalFloors > floors.length || commentCount > shownComments;

function resolveMusicCards(text: string | null | undefined): MusicCard[] {
	return extractMusicRefs(text, MAX_COMMENT_MUSIC).map(
		(ref) => musicCardMap.get(musicRefKey(ref)) ?? { ref, track: null },
	);
}
---

<section class="px-5 pt-5">
	<h2 class="text-[15px] font-semibold">
		评论
		<span class="ml-1.5 text-sm font-normal text-muted-foreground">
			{commentCount}
		</span>
	</h2>
	{
		floors.length === 0 ? (
			<p class="py-12 text-center text-sm text-muted-foreground">
				{commentCount > 0 ? "评论请前往 App 查看" : "还没有公开评论"}
			</p>
		) : (
			<>
				<ol class="divide-y divide-border/70">
					{floors.map((floor) => {
						const first = floor.first;
						const firstTextHtml = renderCommentText(first.text);
						const firstMusicCards = resolveMusicCards(first.text);
						const firstImages = (first.imageUrls || [])
							.map((u) => safeUrl(u))
							.filter((u): u is string => u !== null)
							.slice(0, MAX_COMMENT_IMAGES);
						return (
							<li class="flex gap-3 py-4">
								<ShareAvatar
									url={first.authorAvatarUrl}
									anonymous={first.anonymous}
									authorName={first.authorName}
									sizeClass="size-8"
									size={32}
								/>
								<div class="min-w-0 flex-1">
									<div class="flex items-baseline gap-2">
										<span class="min-w-0 truncate text-[13px] font-medium text-foreground/80">
											{first.authorName?.trim() || "匿名用户"}
										</span>
										<span class="ml-auto shrink-0 text-[11px] text-muted-foreground">
											{formatShareDate(first.createTime)}
										</span>
									</div>
									{firstTextHtml && (
										<p
											class="mt-1 whitespace-pre-wrap break-words text-[15px] leading-relaxed"
											set:html={firstTextHtml}
										/>
									)}
									{firstMusicCards.length > 0 && (
										<ShareMusicCards
											cards={firstMusicCards}
											compact
											class="mt-2 space-y-1.5"
										/>
									)}
									{firstImages.length > 0 && (
										<div class="mt-2 grid w-2/3 grid-cols-3 gap-1">
											{firstImages.map((url) => (
												<a
													class="block aspect-square overflow-hidden rounded-md bg-muted"
													href={url}
													data-lightbox
												>
													<img
														class="size-full object-cover"
														src={url}
														alt="评论图片"
														loading="lazy"
														decoding="async"
														referrerpolicy="no-referrer"
													/>
												</a>
											))}
										</div>
									)}
									{floor.replies && floor.replies.length > 0 && (
										<div class="mt-2.5 space-y-1.5 rounded-lg bg-muted/70 px-3 py-2">
											{floor.replies.map((reply) => {
												const replyTextHtml = renderCommentText(reply.text);
												const replyMusicCards = resolveMusicCards(reply.text);
												return (
													<div>
														<p class="break-words text-[13px] leading-relaxed text-foreground/80">
															<span class="font-medium text-foreground">
																{reply.authorName?.trim() || "匿名用户"}
															</span>
															{reply.replyName?.trim() && (
																<>
																	<span class="text-muted-foreground">
																		{" "}
																		回复{" "}
																	</span>
																	<span class="font-medium text-foreground">
																		{reply.replyName}
																	</span>
																</>
															)}
															{(replyTextHtml ||
																replyMusicCards.length === 0) && (
																<span class="text-muted-foreground">：</span>
															)}
															{replyTextHtml && (
																<span
																	class="whitespace-pre-wrap"
																	set:html={replyTextHtml}
																/>
															)}
														</p>
														{replyMusicCards.length > 0 && (
															<ShareMusicCards
																cards={replyMusicCards}
																compact
																surface="card"
																class="mt-1.5 space-y-1.5"
															/>
														)}
													</div>
												);
											})}
										</div>
									)}
								</div>
							</li>
						);
					})}
				</ol>
				{hasHiddenComments && (
					<p class="border-t border-border/70 py-5 text-center text-xs text-muted-foreground">
						仅展示部分评论，更多评论请前往 App 查看
					</p>
				)}
			</>
		)
	}
</section>
