---
import Layout from "@layouts/Layout.astro";
import { FiArrowLeft } from "react-icons/fi";
import { siteConfig } from "../config";
---

<Layout
	title={`${siteConfig.title} · Page Not Found`}
	description="The page you're looking for doesn't exist"
	showFooter={false}
>
	<main class="flex min-h-screen items-center justify-center">
		<div class="text-center">
			<h1
				class="animate-fade-up text-9xl font-bold text-gray-900 dark:text-white/90"
			>
				404
			</h1>
			<h2
				class="animate-fade-up animate-fade-up-1 mt-8 text-xl font-medium text-gray-900 dark:text-white"
			>
				Page not found
			</h2>
			<p
				class="animate-fade-up animate-fade-up-2 mt-4 text-gray-600 dark:text-gray-400"
			>
				The page you're looking for doesn't exist.
			</p>
			<a
				href="/"
				class="card-lift animate-fade-up animate-fade-up-3 mt-8 inline-flex items-center gap-3 rounded-xl border border-gray-300 bg-white px-5 py-3 outline-none hover:shadow-md focus-visible:ring-4 focus-visible:ring-sky-500/25 active:scale-[0.98] dark:border-white/10 dark:bg-white/[0.04]"
			>
				<FiArrowLeft className="h-5 w-5 text-gray-600 dark:text-gray-300" />
				<span class="font-medium text-gray-900 dark:text-white"
					>Back to Home</span
				>
			</a>
		</div>
	</main>
</Layout>
