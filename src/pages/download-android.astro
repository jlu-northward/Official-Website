---
import Layout from "@layouts/Layout.astro";
import { appInfo } from "../config/appInfo";

const googleLink = appInfo.storeLinks.google;
const targetUrl = typeof googleLink === "function" ? googleLink() : googleLink;
const title = `${appInfo.title} - Android 下载`;
---

<Layout title={title} description={appInfo.description} showFooter={false}>
	<section
		class="flex min-h-screen flex-col items-center justify-center gap-4 px-6 text-center"
	>
		<div class="max-w-md space-y-4">
			<h1
				class="animate-fade-up text-3xl font-semibold text-gray-900 dark:text-white"
			>
				正在跳转到 Android 下载...
			</h1>
			<p
				class="animate-fade-up animate-fade-up-1 text-base text-gray-600 dark:text-gray-300"
			>
				如果没有自动跳转，请
				<a
					class="text-blue-600 underline outline-none focus-visible:ring-2 focus-visible:ring-blue-500/30 dark:text-blue-400"
					href={targetUrl}
					rel="noreferrer"
					target="_blank"
				>
					点击这里直接获取最新 APK
				</a>
				。
			</p>
			<div
				class="animate-fade-up animate-fade-up-2 flex flex-col gap-3 sm:flex-row sm:justify-center"
			>
				<a
					class="card-lift inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-6 py-3 text-sm font-semibold text-gray-900 shadow-sm outline-none hover:shadow-md focus-visible:ring-4 focus-visible:ring-blue-500/25 active:scale-[0.98] dark:border-white/10 dark:bg-white/[0.04] dark:text-white"
					href={targetUrl}
					target="_blank"
					rel="noreferrer"
				>
					立即下载 Android 版本
				</a>
				<a
					class="card-lift inline-flex items-center justify-center rounded-xl border border-transparent bg-gray-900 px-6 py-3 text-sm font-semibold text-white shadow-sm outline-none hover:shadow-md focus-visible:ring-4 focus-visible:ring-blue-500/25 active:scale-[0.98] dark:bg-white/10 dark:text-white"
					href="/"
				>
					返回首页
				</a>
			</div>
		</div>
	</section>

	<script is:inline define:vars={{ targetUrl }}>
		setTimeout(() => {
			window.location.href = targetUrl;
		}, 400);
	</script>
</Layout>
