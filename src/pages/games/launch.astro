---
// 启动页不加载统计或第三方脚本，主凭据仅用于向北同源登录接口。
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="robots" content="noindex,nofollow" />
		<meta name="referrer" content="no-referrer" />
		<title>正在进入游戏｜向北</title>
		<style>
			:root {
				color-scheme: light dark;
				font-family: system-ui, sans-serif;
			}
			body {
				margin: 0;
				min-height: 100svh;
				display: grid;
				place-items: center;
			}
			main {
				text-align: center;
				padding: 24px;
			}
			p {
				opacity: 0.65;
				font-size: 14px;
			}
		</style>
	</head>
	<body>
		<main role="status" aria-live="polite">
			<h1>正在进入游戏…</h1>
			<p id="message">请稍候</p>
		</main>
		<script>
			import { launchGame } from "../../features/games/launch";
			launchGame().catch(() => {
				document.getElementById("message")!.textContent =
					"暂时无法进入，请返回广场重试";
			});
		</script>
	</body>
</html>
