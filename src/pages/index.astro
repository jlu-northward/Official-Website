---
import LandingPage from "@components/sections/LandingPage";
import AmbientGlow from "@components/ui/AmbientGlow";
import Layout from "@layouts/Layout.astro";
import { siteConfig } from "../config";

const { title, description, features, storeLinks, logo, partners } = siteConfig;
const pageDescription =
	"向北 App 是面向吉林大学学生的校园社区，提供校园讨论、吉大课表、真实评分与实用工具。访问官方网站下载 iOS 或 Android 版本。";
const sharedPostId = Astro.url.searchParams.get("postId") ?? "";
if (/^\d+$/.test(sharedPostId) && Number(sharedPostId) > 0) {
	return Astro.redirect(`/post/${sharedPostId}`);
}
---

<Layout
	title={`${title}｜吉大人自己的校园社区`}
	description={pageDescription}
>
	<AmbientGlow />
	<div class="relative z-10">
		<LandingPage
			{title}
			{description}
			{features}
			{storeLinks}
			{logo}
			{partners}
			client:load
		/>
	</div>
</Layout>
