---
import LandingPage from "@components/sections/LandingPage";
import AmbientGlow from "@components/ui/AmbientGlow";
import Layout from "@layouts/Layout.astro";
import { siteConfig } from "../config";

const { title, description, features, storeLinks, logo, partners } = siteConfig;
const sharedPostId = Astro.url.searchParams.get("post") ?? "";
if (/^\d+$/.test(sharedPostId) && Number(sharedPostId) > 0) {
	return Astro.redirect(`/post/${sharedPostId}`);
}
---

<Layout
	title={`${title}｜吉大人自己的校园社区`}
	description={`认识校园，表达自我，连接同路人。求助、分享、点评，听见每一种吉大声音。`}
>
	<AmbientGlow />
	<div class="relative z-10">
		<LandingPage
			{title}
			{description}
			{features}
			{storeLinks}
			{logo}
			{partners}
			client:load
		/>
	</div>
</Layout>
