---
import Layout from "@layouts/Layout.astro";

export const prerender = false;

interface PublicPost {
	postId: number;
	title: string;
	content: string | null;
	coverImage: string | null;
	createTime: string;
	authorName: string | null;
	authorAvatar: string | null;
	likeCount: number | null;
	commentCount: number | null;
	pv: number | null;
}

interface ApiResponse<T> {
	success: boolean;
	data: T | null;
}

Astro.response.headers.set("Cache-Control", "no-store");

const rawPostId = Astro.params.id ?? "";
const validPostId = /^\d+$/.test(rawPostId) && Number(rawPostId) > 0;
let post: PublicPost | null = null;

if (validPostId) {
	try {
		const backendBaseUrl = import.meta.env.BACKEND_BASE_URL ?? "https://api.northward.zone";
		const endpoint = new URL(
			`/api/public/posts/${rawPostId}`,
			backendBaseUrl.endsWith("/") ? backendBaseUrl : `${backendBaseUrl}/`,
		);
		const response = await fetch(endpoint, {
			headers: { Accept: "application/json" },
			cache: "no-store",
		});
		if (response.ok) {
			const body = (await response.json()) as ApiResponse<PublicPost>;
			if (body.success) post = body.data;
		}
	} catch {
		post = null;
	}
}

if (!post) Astro.response.status = 404;

const pageTitle = post ? `${post.title}｜向北` : "帖子暂时无法查看｜向北";
const description = post
	? (post.content || post.title).replace(/\s+/g, " ").trim().slice(0, 100)
	: "这篇帖子暂时无法查看，下载向北 App 发现更多校园讨论。";
const canonical = `https://northward.zone/post/${rawPostId}`;
const publishedAt = post
	? new Intl.DateTimeFormat("zh-CN", {
			month: "long",
			day: "numeric",
			hour: "2-digit",
			minute: "2-digit",
	  }).format(new Date(post.createTime))
	: "";
---

<Layout
	title={pageTitle}
	{description}
	{canonical}
	shareImage={post?.coverImage ?? undefined}
	robots="noindex,nofollow"
	analytics={false}
	wechatGuideOpenOnLoad={false}
	showFooter={false}
>
	<main class="mx-auto min-h-screen max-w-2xl bg-white pb-36 dark:bg-[#09090b]">
		<header class="flex items-center gap-3 px-5 py-4">
			<img
				src="/brand/logo.png"
				alt=""
				class="h-9 w-9 rounded-[0.7rem] shadow-sm"
			/>
			<div>
				<p class="text-[15px] font-semibold tracking-[-0.02em]">向北</p>
				<p class="text-xs text-neutral-500 dark:text-neutral-400">
					吉大人自己的校园社区
				</p>
			</div>
		</header>

		{
			post ? (
				<article>
					{post.coverImage && (
						<img
							src={post.coverImage}
							alt="帖子封面"
							class="block max-h-[72vh] w-full bg-neutral-100 object-contain dark:bg-neutral-900"
						/>
					)}

					<div class="px-5 py-5 sm:px-7">
						<p class="text-sm text-neutral-500 dark:text-neutral-400">
							{publishedAt} · {post.pv ?? 0} 次查看
						</p>

						<div class="mt-5 flex items-center gap-3">
							{post.authorAvatar ? (
								<img
									src={post.authorAvatar}
									alt=""
									class="h-11 w-11 rounded-full object-cover"
								/>
							) : (
								<div class="flex h-11 w-11 items-center justify-center rounded-full bg-neutral-200 text-lg dark:bg-neutral-800">
									北
								</div>
							)}
							<span class="font-medium">{post.authorName || "匿名用户"}</span>
						</div>

						<h1 class="mt-6 text-2xl font-semibold leading-tight tracking-[-0.035em] sm:text-3xl">
							{post.title}
						</h1>
						{post.content && (
							<p class="mt-4 whitespace-pre-wrap break-words text-[17px] leading-8 text-neutral-800 dark:text-neutral-200">
								{post.content}
							</p>
						)}

						<div class="mt-7 flex gap-6 border-t border-neutral-200 pt-5 text-sm text-neutral-600 dark:border-neutral-800 dark:text-neutral-300">
							<span>♡ {post.likeCount ?? 0}</span>
							<span>评论 {post.commentCount ?? 0}</span>
						</div>
					</div>
				</article>
			) : (
				<section class="px-6 py-24 text-center">
					<h1 class="text-2xl font-semibold tracking-[-0.03em]">
						帖子暂时无法查看
					</h1>
					<p class="mt-3 text-sm leading-6 text-neutral-500 dark:text-neutral-400">
						内容可能已删除、设为私密，或链接有误。
					</p>
				</section>
			)
		}
	</main>

	<div class="fixed inset-x-0 bottom-0 z-50 px-4 pb-[max(1rem,env(safe-area-inset-bottom))] pt-3">
		<div class="mx-auto max-w-2xl">
			<a
				id="download-app"
				href="/#download"
				class="flex min-h-14 items-center justify-center rounded-full bg-neutral-950 px-6 text-base font-semibold text-white shadow-[0_16px_38px_rgba(15,23,42,0.24)] outline-none focus-visible:ring-4 focus-visible:ring-sky-500/30 active:scale-[0.97] dark:bg-white dark:text-neutral-950"
			>
				下载向北 App，查看更多讨论
			</a>
		</div>
	</div>

	<script is:inline>
		const downloadLink = document.querySelector("#download-app");
		if (downloadLink instanceof HTMLAnchorElement) {
			const userAgent = navigator.userAgent.toLowerCase();
			if (/iphone|ipad|ipod/.test(userAgent)) {
				downloadLink.href = "/download-ios";
			} else if (/android/.test(userAgent)) {
				downloadLink.href = "/download-android";
			}
		}
	</script>
</Layout>
