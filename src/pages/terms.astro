---
import BackToTop from "@components/ui/BackToTop";
import Breadcrumbs from "@components/ui/Breadcrumbs";
import Layout from "@layouts/Layout.astro";
import { marked } from "marked";
import { siteConfig } from "../config";

const termsContent = Object.values(
	import.meta.glob("./content/terms.md", { eager: true }),
)[0] as { rawContent(): string };
const htmlContent = marked(termsContent.rawContent());
---

<Layout
	title={`${siteConfig.title} · 用户协议`}
	description={`${siteConfig.title}App 用户协议：使用向北服务前请阅读的规则、权利与义务说明。`}
>
	<main class="mx-auto min-h-screen max-w-3xl px-4 py-8">
		<Breadcrumbs items={[{ label: "用户协议" }]} />
		<div
			class="animate-fade-up animate-fade-up-1 prose prose-sm prose-gray max-w-none sm:prose-base dark:prose-invert"
		>
			<div set:html={htmlContent} />
		</div>
	</main>
	<BackToTop client:load />
</Layout>

<style is:global>
	.prose {
		--tw-prose-headings: theme(colors.gray.900);
		--tw-prose-links: theme(colors.blue.600);
		--tw-prose-bold: theme(colors.gray.900);
		--tw-prose-invert-headings: theme(colors.white);
		--tw-prose-invert-links: theme(colors.blue.400);
		--tw-prose-invert-bold: theme(colors.white);
	}

	.prose {
		a {
			text-decoration: underline;
			text-underline-offset: 0.18em;
		}

		h1,
		h2,
		h3,
		h4,
		h5,
		h6 {
			color: theme(colors.gray.900);
		}
		p,
		li {
			color: theme(colors.gray.700);
		}
		strong {
			color: theme(colors.gray.800);
		}
	}

	.dark .prose {
		h1,
		h2,
		h3,
		h4,
		h5,
		h6 {
			color: theme(colors.white);
		}
		p,
		li {
			color: theme(colors.gray.300);
		}
		strong {
			color: theme(colors.gray.200);
		}
	}
</style>
