{
	"headers": [
		{
			"source": "/.well-known/apple-app-site-association",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/json"
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/",
			"has": [
				{
					"type": "query",
					"key": "postId",
					"value": "(?<postId>\\d+)"
				}
			],
			"destination": "/post/:postId",
			"permanent": true
		}
	]
}
